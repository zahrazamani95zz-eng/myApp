# OpenIddict / OIDC SSO
OIDC_ISSUER=http://94.101.177.15:8090/
OIDC_CLIENT_ID=nextjs-web
OIDC_CLIENT_SECRET=replace-with-backend-client-secret
AUTH_SECRET=replace-with-a-long-random-secret

# The app origin is not used to build the OAuth flow manually.
# NextAuth derives the callback URL from the incoming request.
# Backend must allow this exact callback:
# http://localhost:3001/api/auth/callback/openiddict

