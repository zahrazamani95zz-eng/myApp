{
  "name": "super-app",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "type-check": "turbo run type-check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "rebuild": "pnpm clean && pnpm install && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:ml": "turbo run dev --filter=ml-app",
    "build:ml": "turbo run build --filter=ml-app",
    "dev:admin": "turbo run dev --filter=admin-app",
    "build:admin": "turbo run build --filter=admin-app",
    "storybook": "turbo run storybook --filter=@super-app/shared",
    "build:storybook": "turbo run build-storybook --filter=@super-app/shared",
    "check": "pnpm lint && pnpm type-check && pnpm build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
     "@next/eslint-plugin-next": "^16.4.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "prettier-eslint": "^16.4.2",
    "rimraf": "^6.1.3",
    "turbo": "^2.9.18",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.14.27",
    "@assistant-ui/react-markdown": "^0.14.6",
    "@reduxjs/toolkit": "^2.12.0",
    "@super-app/typescript-config": "workspace:*",
    "@tailwindcss/typography": "^0.5.20",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "next": "16.4.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-redux": "^9.3.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "pnpm exec eslint --fix --cache --max-warnings=0",
      "pnpm exec prettier --write"
    ],
    "*.{json,md,css,scss,html}": [
      "pnpm exec prettier --write"
    ]
  }
}
