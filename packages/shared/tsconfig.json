{
  "extends": "../../tooling/typescript/library.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": false,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "module": "ESNext",
    "target": "ES2023",
    "types": [
      "node"
    ],
    "sourceMap": false
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "references": [
    {
      "path": "../core"
    }
  ]
}
